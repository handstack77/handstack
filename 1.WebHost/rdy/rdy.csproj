<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <TargetFramework>net10.0</TargetFramework>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <PublishWithAspNetCoreTargetManifest>true</PublishWithAspNetCoreTargetManifest>
        <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
        <Nullable>enable</Nullable>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableDefaultCompressedItems>false</EnableDefaultCompressedItems>
        <CompressionEnabled>false</CompressionEnabled>
        <Deterministic>false</Deterministic>
        <IsPublishable>True</IsPublishable>
        <AssemblyName>rdy</AssemblyName>
        <RootNamespace>rdy</RootNamespace>
        <Description>기본 모듈은 정적으로 결합하고 추가 모듈은 런타임에 동적으로 로드하는 단일 실행 프로젝트</Description>
        <NoWarn>IL3000;IL3002;NU1903;ASP0023;NU1608;NU1510;CA1416;</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>none</DebugType>
        <DebugSymbols>False</DebugSymbols>
        <Optimize>True</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
        <Optimize>False</Optimize>
    </PropertyGroup>

    <PropertyGroup>
        <RdyWwwrootSourceDir Condition="'$(RdyWwwrootSourceDir)' == ''">$(HANDSTACK_SRC)/2.Modules/wwwroot/wwwroot</RdyWwwrootSourceDir>
        <RdyServerPort Condition="'$(RdyServerPort)' == ''">8420</RdyServerPort>
    </PropertyGroup>

    <ItemGroup Label="modules, HandStack Library">
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.9" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
        <PackageReference Include="MySql.Data" Version="9.7.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
        <PackageReference Include="RestSharp" Version="114.0.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SkiaSharp" Version="4.148.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
        <PackageReference Include="Sqids" Version="3.2.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
        <PackageReference Include="System.CommandLine" Version="2.0.9" />
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
        <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
        <PackageReference Include="System.Runtime.Caching" Version="10.0.9" />
        <PackageReference Include="System.Windows.Extensions" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup Label="static modules">
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/command/command.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/dbclient/dbclient.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/function/function.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/graphclient/graphclient.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/logger/logger.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/prompter/prompter.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/repository/repository.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/transact/transact.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/wwwroot/wwwroot.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="HandStack.Core">
            <HintPath>$(HANDSTACK_SRC)/3.Infrastructure/Assemblies/$(Configuration)/HandStack.Core.dll</HintPath>
        </Reference>
        <Reference Include="HandStack.Web">
            <HintPath>$(HANDSTACK_SRC)/3.Infrastructure/Assemblies/$(Configuration)/HandStack.Web.dll</HintPath>
        </Reference>
        <Reference Include="HandStack.Data">
            <HintPath>$(HANDSTACK_SRC)/3.Infrastructure/Assemblies/$(Configuration)/HandStack.Data.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="build/**;modules/**" />
        <None Include="wwwroot/**" />
        <None Update="wwwroot/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="modules/**" />
        <None Update="modules/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Remove="modules/**/node_modules/**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="checkip.js">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="content-security-policy.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="task.bat">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="task.ps1">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="task.sh">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <UsingTask TaskName="ReplaceRdyFileText"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
            <Pattern ParameterType="System.String" Required="true" />
            <Replacement ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var content = File.ReadAllText(FilePath);
                var updated = Regex.Replace(content, Pattern, Replacement, RegexOptions.CultureInvariant);

                if (!string.Equals(content, updated, StringComparison.Ordinal))
                {
                    File.WriteAllText(FilePath, updated, new UTF8Encoding(false));
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="SyncRdyWwwroot"
            AfterTargets="Build"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <RdyWwwrootOutputDir Condition="'$(RdyWwwrootOutputDir)' == '' and '$(PublishSingleFile)' == 'true' and '$(PublishDir)' != ''">$(PublishDir)modules/wwwroot/wwwroot</RdyWwwrootOutputDir>
            <RdyWwwrootOutputDir Condition="'$(RdyWwwrootOutputDir)' == ''">$(TargetDir)modules/wwwroot/wwwroot</RdyWwwrootOutputDir>
            <RdySynConfigPath>$(RdyWwwrootOutputDir)/syn.config.json</RdySynConfigPath>
        </PropertyGroup>

        <Error Condition="!Exists('$(RdyWwwrootSourceDir)')"
               Text="wwwroot 원본 디렉터리를 찾을 수 없습니다: $(RdyWwwrootSourceDir)" />

        <RemoveDir Directories="$(RdyWwwrootOutputDir)"
                   Condition="Exists('$(RdyWwwrootOutputDir)')" />

        <ItemGroup>
            <_RdyWwwrootSourceFiles Include="$(RdyWwwrootSourceDir)/**/*"
                                    Exclude="$(RdyWwwrootSourceDir)/**/node_modules/**/*;$(RdyWwwrootSourceDir)/**/.github/**/*" />
        </ItemGroup>

        <MakeDir Directories="$(RdyWwwrootOutputDir)" />
        <Copy SourceFiles="@(_RdyWwwrootSourceFiles)"
              DestinationFiles="@(_RdyWwwrootSourceFiles->'$(RdyWwwrootOutputDir)/%(RecursiveDir)%(Filename)%(Extension)')" />

        <Error Condition="!Exists('$(RdySynConfigPath)')"
               Text="복사된 syn.config.json을 찾을 수 없습니다: $(RdySynConfigPath)" />

        <ReplaceRdyFileText FilePath="$(RdySynConfigPath)"
                            Pattern="(?&lt;![0-9])8421(?![0-9])"
                            Replacement="$(RdyServerPort)" />
    </Target>

    <Target Name="PruneModuleTransitiveContent"
            AfterTargets="GetCopyToOutputDirectoryItems"
            BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways">
        <ItemGroup>
            <_SourceItemsToCopyToOutputDirectory
                Remove="@(_SourceItemsToCopyToOutputDirectory)"
                Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/2.Modules/'))" />
            <_SourceItemsToCopyToOutputDirectoryAlways
                Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)"
                Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/2.Modules/'))" />
        </ItemGroup>
    </Target>

    <Target Name="PruneModuleTransitivePublishContent"
            AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/2.Modules/'))
                           and ('%(Filename)%(Extension)' == 'module.json'
                                 or '%(Filename)%(Extension)' == 'package.json'
                                 or '%(Filename)%(Extension)' == 'package-lock.json'
                                 or $([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('Contracts/'))
                                 or $([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('Prompts/'))
                                 or $([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('Settings/'))
                                 or $([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('SQL/')))" />
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb'" />
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(RelativePath)').Replace('\','/')) == 'gulpfile.js'
                           or $([System.String]::Copy('%(RelativePath)').Replace('\','/')) == 'libman.json'
                           or $([System.String]::Copy('%(RelativePath)').Replace('\','/')) == 'node.config.json'
                           or $([System.String]::Copy('%(RelativePath)').Replace('\','/')) == 'featureTest.js'
                           or $([System.String]::Copy('%(RelativePath)').Replace('\','/')) == 'featureTest.json'
                           or $([System.String]::Copy('%(RelativePath)').Replace('\','/')) == 'function.dll.config'" />
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('wwwroot/_content/'))
                           or $([System.String]::Copy('%(RelativePath)').EndsWith('.br'))
                           or $([System.String]::Copy('%(RelativePath)').EndsWith('.gz'))" />
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('.github/'))
                           or $([System.String]::Copy('%(RelativePath)').Replace('\','/').Contains('/.github/'))" />
        </ItemGroup>
    </Target>

    <Target Name="PruneModuleTransitivePublishDirectories"
            AfterTargets="Publish"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
        <PropertyGroup>
            <_RdyPublishRoot>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_RdyPublishRoot>
        </PropertyGroup>
        <ItemGroup>
            <_RdyTransitivePublishDirectory Include="$(_RdyPublishRoot)/Contracts" Condition="Exists('$(_RdyPublishRoot)/Contracts')" />
            <_RdyTransitivePublishDirectory Include="$(_RdyPublishRoot)/Prompts" Condition="Exists('$(_RdyPublishRoot)/Prompts')" />
            <_RdyTransitivePublishDirectory Include="$(_RdyPublishRoot)/Settings" Condition="Exists('$(_RdyPublishRoot)/Settings')" />
            <_RdyTransitivePublishDirectory Include="$(_RdyPublishRoot)/SQL" Condition="Exists('$(_RdyPublishRoot)/SQL')" />
            <_RdyTransitivePublishDirectory Include="$(_RdyPublishRoot)/wwwroot/_content" Condition="Exists('$(_RdyPublishRoot)/wwwroot/_content')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/libSkiaSharp.pdb" Condition="Exists('$(_RdyPublishRoot)/libSkiaSharp.pdb')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/gulpfile.js" Condition="Exists('$(_RdyPublishRoot)/gulpfile.js')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/libman.json" Condition="Exists('$(_RdyPublishRoot)/libman.json')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/node.config.json" Condition="Exists('$(_RdyPublishRoot)/node.config.json')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/featureTest.js" Condition="Exists('$(_RdyPublishRoot)/featureTest.js')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/featureTest.json" Condition="Exists('$(_RdyPublishRoot)/featureTest.json')" />
            <_RdyPublishFileToRemove Include="$(_RdyPublishRoot)/function.dll.config" Condition="Exists('$(_RdyPublishRoot)/function.dll.config')" />
            <_RdyCompressedPublishFile Include="$(_RdyPublishRoot)/**/*.br;$(_RdyPublishRoot)/**/*.gz" />
            <_RdyHiddenPublishDirectory Include="$([System.IO.Directory]::GetDirectories('$(_RdyPublishRoot)', '.github', System.IO.SearchOption.AllDirectories))"
                                        Condition="Exists('$(_RdyPublishRoot)')" />
        </ItemGroup>
        <Delete Files="@(_RdyCompressedPublishFile)" />
        <RemoveDir Directories="@(_RdyHiddenPublishDirectory)" />
        <RemoveDir Directories="@(_RdyTransitivePublishDirectory)" />
        <Delete Files="@(_RdyPublishFileToRemove)" />
    </Target>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <RemoveDir Directories="$(TargetDir)" Condition="Exists('$(TargetDir)')" />
    </Target>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <RuntimesDir>$(TargetDir)runtimes</RuntimesDir>
        </PropertyGroup>
        <ItemGroup Condition="Exists('$(RuntimesDir)')">
            <RuntimeDirsToRemove Include="$([System.IO.Directory]::GetDirectories('$(RuntimesDir)'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'win'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'unix'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'linux'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'osx'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'win-x64'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'linux-x64'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'osx-x64'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'osx-arm64'))" />
        </ItemGroup>
        <RemoveDir Directories="@(RuntimeDirsToRemove)" Condition="'@(RuntimeDirsToRemove)' != ''" />
    </Target>
</Project>
