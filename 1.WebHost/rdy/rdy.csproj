<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <TargetFramework>net10.0</TargetFramework>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <PublishWithAspNetCoreTargetManifest>true</PublishWithAspNetCoreTargetManifest>
        <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
        <Nullable>enable</Nullable>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableDefaultCompressedItems>false</EnableDefaultCompressedItems>
        <CompressionEnabled>false</CompressionEnabled>
        <Deterministic>false</Deterministic>
        <IsPublishable>True</IsPublishable>
        <AssemblyName>rdy</AssemblyName>
        <RootNamespace>rdy</RootNamespace>
        <Description>ack 호스트와 command, dbclient, function, logger, repository, transact, wwwroot 모듈을 정적으로 결합한 단일 실행 프로젝트</Description>
        <NoWarn>IL3000;IL3002;NU1903;ASP0023;NU1608;NU1510;CA1416;</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>none</DebugType>
        <DebugSymbols>False</DebugSymbols>
        <Optimize>True</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
        <Optimize>False</Optimize>
    </PropertyGroup>

    <ItemGroup Label="modules, HandStack Library">
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.9" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
        <PackageReference Include="MySql.Data" Version="9.7.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
        <PackageReference Include="RestSharp" Version="114.0.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SkiaSharp" Version="4.148.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
        <PackageReference Include="Sqids" Version="3.2.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
        <PackageReference Include="System.CommandLine" Version="2.0.9" />
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
        <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
        <PackageReference Include="System.Runtime.Caching" Version="10.0.9" />
        <PackageReference Include="System.Windows.Extensions" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup Label="static modules">
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/command/command.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/dbclient/dbclient.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/function/function.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/logger/logger.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/repository/repository.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/transact/transact.csproj" />
        <ProjectReference Include="$(HANDSTACK_SRC)/2.Modules/wwwroot/wwwroot.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="HandStack.Core">
            <HintPath>$(HANDSTACK_SRC)/3.Infrastructure/Assemblies/$(Configuration)/HandStack.Core.dll</HintPath>
        </Reference>
        <Reference Include="HandStack.Web">
            <HintPath>$(HANDSTACK_SRC)/3.Infrastructure/Assemblies/$(Configuration)/HandStack.Web.dll</HintPath>
        </Reference>
        <Reference Include="HandStack.Data">
            <HintPath>$(HANDSTACK_SRC)/3.Infrastructure/Assemblies/$(Configuration)/HandStack.Data.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="build/**" />
        <None Include="wwwroot/**" />
        <None Update="wwwroot/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="modules/**" />
        <None Update="modules/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="checkip.js">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="PruneModuleTransitiveContent"
            AfterTargets="GetCopyToOutputDirectoryItems"
            BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways">
        <ItemGroup>
            <_SourceItemsToCopyToOutputDirectory
                Remove="@(_SourceItemsToCopyToOutputDirectory)"
                Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/2.Modules/'))" />
            <_SourceItemsToCopyToOutputDirectoryAlways
                Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)"
                Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/2.Modules/'))" />
        </ItemGroup>
    </Target>

    <Target Name="PruneModuleTransitivePublishContent"
            AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/2.Modules/'))
                           and ('%(Filename)%(Extension)' == 'module.json'
                                or '%(Filename)%(Extension)' == 'package.json'
                                or '%(Filename)%(Extension)' == 'package-lock.json')" />
        </ItemGroup>
    </Target>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <RemoveDir Directories="$(TargetDir)" Condition="Exists('$(TargetDir)')" />
    </Target>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <RuntimesDir>$(TargetDir)runtimes</RuntimesDir>
        </PropertyGroup>
        <ItemGroup Condition="Exists('$(RuntimesDir)')">
            <RuntimeDirsToRemove Include="$([System.IO.Directory]::GetDirectories('$(RuntimesDir)'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'win'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'unix'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'linux'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'osx'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'win-x64'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'linux-x64'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'osx-x64'))" />
            <RuntimeDirsToRemove Remove="$([System.IO.Path]::Combine('$(RuntimesDir)', 'osx-arm64'))" />
        </ItemGroup>
        <RemoveDir Directories="@(RuntimeDirsToRemove)" Condition="'@(RuntimeDirsToRemove)' != ''" />
    </Target>
</Project>
