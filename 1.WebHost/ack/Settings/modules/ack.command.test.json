            "../contracts/command"
        ],
        "IsTransactionLogging": false,
        "ModuleLogFilePath": "../log/command/module.log",
        "IsLogServer": true,
        "LogServerUrl": "https://test.example-domain.com/logger/api/log/insert",
        "EventAction": [],
        "SubscribeAction": []
    }
}

